{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for editor windows",
	"windows": ["*"],
	"permissions": [
		"core:default",
		"core:window:allow-set-title",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"opener:default",
		"dialog:default",
		"fs:allow-write-text-file"
	]
}
